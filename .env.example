# LLM Provider Configuration
LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Repository Backend Configuration (local | supabase)
REPO_BACKEND=local
REPO_FALLBACK=1

# Supabase (server-side only, required when REPO_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Component Implementation Modes (stub | real)
TRUST_IMPL=stub
POLICY_IMPL=stub
